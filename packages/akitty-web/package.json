{
  "name": "@ax-code/akitty-web",
  "version": "0.5.1",
  "private": true,
  "description": "AkiTTY Web: AX Code Desktop's in-app canvas terminal, a canvas terminal over Ghostty's VT parser compiled to WebAssembly",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./ghostty-vt.wasm": "./ghostty-vt.wasm"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:wasm": "bash scripts/build-wasm.sh",
    "browser:serve": "vite --host 127.0.0.1 --port 4179 --strictPort",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
