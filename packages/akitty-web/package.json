{
  "name": "@ax-code/akitty-web",
  "version": "0.6.6",
  "private": true,
  "description": "Canvas terminal using the shared AkiTTY Rust VT engine compiled to WebAssembly",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./akitty-vt.wasm": "./akitty-vt.wasm"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "build:wasm": "bash scripts/build-wasm.sh",
    "browser:serve": "vite --host 127.0.0.1 --port 4179 --strictPort",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "happy-dom": "21.0.4",
    "typescript": "7.1.0-beta",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
