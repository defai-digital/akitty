{
  "name": "@defai-digital/akitty-sdk",
  "version": "0.3.0",
  "description": "Typed terminal title and AkiTTY program chrome client over OSC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defai-digital/akitty.git",
    "directory": "packages/akitty-sdk"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.1.0-beta"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
