{
  "name": "akitty-linux-experimental",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsc -p tsconfig.web.json && vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -p tsconfig.web.json && tsc --noEmit && vite build",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "package": "cargo build --manifest-path src-tauri/Cargo.toml --locked --release --no-default-features --bin akitty-agent && python3 scripts/stage_companion.py && tauri build -- --locked"
  },
  "dependencies": { "@tauri-apps/api": "2.12.4" },
  "devDependencies": { "@tauri-apps/cli": "2.12.4", "typescript": "5.9.3", "vite": "8.3.5", "@types/node": "26.6.5" }
}
